{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Java V2X App API",
      "type": "java",
      "request": "launch",
      "mainClass": "usdot.v2x.app.api.V2XAppApiApplication",
      "projectName": "v2x-app-api",
      "envFile": "${workspaceFolder}/.env",
      "vmArgs": "--enable-native-access=ALL-UNNAMED",
      "preLaunchTask": "run-keycloak"
    },
    {
      "name": "Java MQTT Router",
      "type": "java",
      "request": "launch",
      "mainClass": "usdot.v2x.mqtt.router.MqttRouterApplication",
      "projectName": "mqtt-router",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "run-mosquitto"
    },
    {
      "name": "Debug HiveMQ Extension (Attach)",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "projectName": "hivemq-v2x-routing-extension",
      "preLaunchTask": "run-hivemq-debug",
      "postDebugTask": null
    },
    {
      "name": "Debug HiveMQ Extension (Build & Attach)",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "projectName": "hivemq-v2x-routing-extension",
      "preLaunchTask": "build-and-start-hivemq",
      "postDebugTask": null
    }
  ]
}