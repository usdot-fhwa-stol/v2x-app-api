{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-keycloak",
      "type": "docker-compose",
      "dockerCompose": {
        "up": {
          "detached": true,
          "build": true,
          "profiles": [
            "keycloak",
            "postgres"
          ],
          "removeOrphans": true
        },
        "files": [
          "${workspaceFolder}/docker-compose.yml"
        ],
        "envFile": "${workspaceFolder}/.env"
      }
    },
    {
      "label": "run-mosquitto",
      "type": "docker-compose",
      "dockerCompose": {
        "up": {
          "detached": true,
          "build": false,
          "profiles": [
            "mqtt"
          ],
          "removeOrphans": true
        },
        "files": [
          "${workspaceFolder}/docker-compose.yml"
        ],
        "envFile": "${workspaceFolder}/.env"
      }
    }
  ]
}