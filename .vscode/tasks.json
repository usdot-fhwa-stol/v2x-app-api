{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-keycloak",
      "type": "docker-compose",
      "dockerCompose": {
        "up": {
          "detached": true,
          "build": true,
          "profiles": [
            "keycloak",
            "postgres"
          ],
          "removeOrphans": true
        },
        "files": [
          "${workspaceFolder}/docker-compose.yml"
        ],
        "envFile": "${workspaceFolder}/.env"
      }
    },
    {
      "label": "gradle-compile",
      "type": "shell",
      "command": "./gradlew compileJava processResources",
      "options": {
        "cwd": "${workspaceFolder}/v2x-app-api"
      },
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": "$java",
      "dependsOn": "run-keycloak"
    },
    {
      "label": "sync-classes-to-bin",
      "type": "shell",
      "command": "rsync -a --delete build/classes/java/main/ bin/main/ && rsync -a build/resources/main/ bin/main/ 2>/dev/null || true",
      "options": {
        "cwd": "${workspaceFolder}/v2x-app-api"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "dependsOn": "gradle-compile"
    }
  ]
}