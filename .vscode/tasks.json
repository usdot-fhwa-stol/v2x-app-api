{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-keycloak",
      "type": "docker-compose",
      "dockerCompose": {
        "up": {
          "detached": true,
          "build": true,
          "profiles": [
            "keycloak",
            "postgres"
          ],
          "removeOrphans": true
        },
        "files": [
          "${workspaceFolder}/docker-compose.yml"
        ],
        "envFile": "${workspaceFolder}/.env"
      }
    },
    {
      "label": "run-mosquitto",
      "type": "docker-compose",
      "dockerCompose": {
        "up": {
          "detached": true,
          "build": false,
          "profiles": [
            "mqtt"
          ],
          "removeOrphans": true
        },
        "files": [
          "${workspaceFolder}/docker-compose.yml"
        ],
        "envFile": "${workspaceFolder}/.env"
      }
    },
    {
      "label": "build-hivemq-extension",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        "clean",
        "buildExtension",
        "-p",
        "hivemq-v2x-routing-extension"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "run-hivemq-debug",
      "type": "docker-compose",
      "dockerCompose": {
        "up": {
          "detached": true,
          "build": true,
          "profiles": [
            "hivemq"
          ],
          "removeOrphans": true
        },
        "files": [
          "${workspaceFolder}/docker-compose.yml"
        ],
        "envFile": "${workspaceFolder}/.env"
      }
    },
    {
      "label": "build-and-start-hivemq",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build-hivemq-extension",
        "run-hivemq-debug"
      ],
      "problemMatcher": []
    }
  ]
}