DOCKER_HOST_IP=

# Available profiles: postgres, keycloak, v2x-app-api, kafka-producer, all (default)
COMPOSE_PROFILES=all

# Docker compose restart policy: https://docs.docker.com/engine/containers/start-containers-automatically/
RESTART_POLICY="no"

# PostgreSQL Database Configuration
POSTGRES_DB=v2x_app_db
POSTGRES_USER=admin_user
POSTGRES_PASSWORD=change_me_123

SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Keycloak authentication credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_123

# Keycloak Parameters - to generate secret key use a password generator such as: https://www.avast.com/en-us/random-password-generator#pc and set the length to 32
KEYCLOAK_ENDPOINT=http://${DOCKER_HOST_IP}:8084
KEYCLOAK_REALM=v2x-app
KEYCLOAK_CLIENT_NAME=v2x-app-api
KEYCLOAK_CLIENT_SECRET=change_this_for_production_use

# Thingspace credentials (key and secret) can be obtained from Verizon by following steps 1-3 of this Obtaining an access_token guide: https://thingsspace.verizon.com/documentation/api-documentation.html#/http/quick-start/credentials-and-tokens/obtaining-an-access_token
THINGSPACE_ENABLED=true
THINGSPACE_KEY=
THINGSPACE_SECRET=
THINGSPACE_ENDPOINT=https://thingspace.verizon.com

# Session token lifespan for Thingspace tokens. The expiration time for Thingspace tokens are not returned with the tokens.
# From our testing, the access_token expires after 1 hour, and the session_token seems to expire after about 15-30 minutes.
# This value can be specified as a duration (e.g., "10m", "30s", "1h", "PT10M"). Default: 10 minutes.
THINGSPACE_SESSION_TOKEN_LIFESPAN=10m

# The V2X App API has the ability to periodically re-generate the thingspace credentials, to ensure they never go cold. This can be enabled through setting this to true
TOKEN_PERIODIC_REGENERATION=true

ETX_ENABLED=true
ETX_ENDPOINT=https://imp.thingspace.verizon.com
ETX_VENDOR_ID=
ETX_DEPOSITOR_VENDOR_ID=${ETX_VENDOR_ID}
ETX_VENDOR_USERNAME=
ETX_VENDOR_PASSWORD=

# ETX Vendor Registration Limits
ETX_VENDOR_REGISTRATION_LIMIT=50
ETX_VENDOR_USER_REGISTRATION_LIMIT=5
ETX_DEPOSITOR_VENDOR_REGISTRATION_LIMIT=10
ETX_DEPOSITOR_VENDOR_USER_REGISTRATION_LIMIT=3

GEOFENCE_OFFSET_METERS=100.0
DEFAULT_LANE_WIDTH_CM=1500.0

# Secret Configuration
ISS_SCMS_TOKEN=token
S3_ACCESS_KEY=key
S3_SECRET_KEY=key
S3_BUCKET_NAME=name
S3_REGION=region
S3_DESTINATION=destination
MAPBOX_ACCESS_TOKEN=mapbox_access_token
NOAA_GEOMAG_API_TOKEN=noaa-geomag-api-token

# Deployment mode for TIM messages:
# ETX_CONFIGURATION_API - Use ETX Configuration API for deployments
# GEOFENCE_MQTT - Store in database for MQTT broker distribution
DEPOSIT_MODE=ETX_CONFIGURATION_API

GEOFENCE_CLEANUP_ENABLED=false
# Cleanup interval duration. Supports Spring Boot duration format (e.g., "5m", "30s", "1h")
# or ISO-8601 duration format (e.g., "PT5M", "PT30S", "PT1H"). Default: 5 minutes.
GEOFENCE_CLEANUP_INTERVAL=5m

# Use full system path if debugging in IDE, otherwise use relative path to the project root
TIM_CONFIG_FILE_PATH=/tim_config_files/tim-config.json
TIM_ICONS_DIRECTORY=/tim_config_files/tim-icons

# TIM Configuration
GEOFENCE_GEOHASH_PRECISION=6
GEOFENCE_LIMITS_MAX_GEOHASHES=500
GEOFENCE_EXPIRATION_CLEANUP_ENABLED=true
# Cleanup interval duration. Supports Spring Boot duration format (e.g., "5m", "30s", "1h")
# or ISO-8601 duration format (e.g., "PT5M", "PT30S", "PT1H"). Default: 5 minutes.
GEOFENCE_EXPIRATION_CLEANUP_INTERVAL=5m
# Grace period duration. Supports Spring Boot duration format (e.g., "2h", "30m", "1d")
# or ISO-8601 duration format (e.g., "PT2H", "PT30M", "P1D"). Default: 2 hours.
GEOFENCE_EXPIRATION_GRACE_PERIOD=2h

# Keycloak logging level - options are "ALL", "FATAL", "OFF", "TRACE" and "WARN"
KC_LOGGING_LEVEL="WARN"

# Logging level - options are "TRACE", "DEBUG", "INFO", "SUCCESS", "WARNING", "ERROR", and "CRITICAL"
API_LOGGING_LEVEL=INFO

# Kafka Producer (kafka-producer/) — publishes GeoHashRoutedMsg protobuf to Kafka at 1 Hz
# Requires PostgreSQL LISTEN/NOTIFY on table_updates (init-db.sql or migration 008)
# Spring profile: default, local, or confluent (Confluent Cloud SASL_SSL)
KAFKA_PRODUCER_SPRING_PROFILES_ACTIVE=default
# Kafka broker list (host:port). For Docker, use a reachable broker address (not localhost from inside the container unless Kafka runs on the host network).
KAFKA_BOOTSTRAP_SERVERS=${DOCKER_HOST_IP}:9092
# Hostname for Postgres JDBC URL in Docker Compose (service name when using compose)
POSTGRES_HOST=${DOCKER_HOST_IP}
# Confluent Cloud credentials (only when KAFKA_PRODUCER_SPRING_PROFILES_ACTIVE=confluent)
CONFLUENT_KEY=
CONFLUENT_SECRET=

# Let's Encrypt / nginx-proxy (docker-compose-lets-encrypt.yml)
# Use: docker compose -f docker-compose.yml -f docker-compose-lets-encrypt.yml up -d
# DNS for KC_DOMAIN and V2X_API_DOMAIN must resolve to this server; ports 80 and 443 must be open.
LETSENCRYPT_EMAIL=admin@example.com
KC_DOMAIN=auth.example.com
V2X_API_DOMAIN=api.example.com
# When using the Let's Encrypt overlay, point the API at the public HTTPS auth URL:
# KEYCLOAK_ENDPOINT=https://${KC_DOMAIN}