FROM python:3.12-slim

WORKDIR /app

COPY ./mqtt-ode-bridge/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ./mqtt-ode-bridge/mqtt_ode_bridge.py .

RUN useradd --system --uid 10001 --no-create-home bridge
USER bridge

ENV PYTHONUNBUFFERED=1 \
    HEARTBEAT_FILE=/tmp/mqtt-ode-bridge.heartbeat

# Healthy while connected to the broker (heartbeat touched every 10 s).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "mqtt_ode_bridge.py", "--healthcheck"]

ENTRYPOINT ["python", "mqtt_ode_bridge.py"]
